      "category": "racism",
      "weight": 0.75,
      "pattern": "\\b(?:dirty|filthy)\\s+(?:muslims?|jews?|blacks|black\\s+(?:people|man|men|woman|women|guys?|bastards?|cunts?|scum))\\b|\\byou\\s+(?:dirty|filthy)\\s+black\\b",
