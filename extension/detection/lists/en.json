      "category": "racism",
      "weight": 0.85,
      "pattern": "(?<![\\p{L}\\p{N}])(?:chinks?)(?![\\p{L}\\p{N}])(?!\\s+in\\s+(?:the|his|her|their|its|my|your|our|a)\\s+(?:armou?r|curtains?|clouds?|walls?|fences?|doors?))(?!\\s+of\\s+(?:light|sunlight|daylight|hope|glass(?:es)?|coins?))",
      "flags": "iu",
