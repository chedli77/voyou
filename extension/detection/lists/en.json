      "weight": 0.8,
      "pattern": "\\b(?:all|these|those|the)\\s+(?:muslims|jews|christians)\\s+(?:should|must|need\\s+to)\\s+(?:die(?!\\s+to\\b)|be\\s+(?:killed|gassed|deported|exterminated))\\b",
