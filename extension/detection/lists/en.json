    },
    {
      "id": "pat-en-white-power",
      "category": "racism",
      "weight": 0.8,
      "pattern": "\\b(?:white\\s*power(?![\\s\\p{Pd}_]*(?:cables?|cords?|buttons?|supply|supplies|adapters?|banks?|strips?|bricks?|outlets?|sockets?|plugs?|switch(?:es)?|leds?|lights?|rangers?)\\b)|wpww)\\b",
